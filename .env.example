# Da inserire in Netlify > Site configuration > Environment variables
BOT_TOKEN=123456:ABC...            # token da @BotFather
BOT_USERNAME=NomeDelTuoBot         # senza @
ADMIN_IDS=123456789                # il tuo Telegram user ID (piu' admin: separati da virgola)
WEBHOOK_SECRET=una_parola_segreta_lunga_123   # solo lettere, numeri, _ e -
SITE_URL=https://tuosito.netlify.app          # opzionale ma consigliato
TMDB_API_KEY=                      # opzionale (poster e trame automatici)
PROTECT_CONTENT=false              # true = impedisce inoltro/salvataggio dei video
MAX_SENDS_PER_MIN=6                # anti-abuso: invii video al minuto per utente
